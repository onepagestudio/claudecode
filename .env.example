# ==== 必填：請至 LINE Developers Console 取得 ====
# Messaging API 頻道的 Channel Access Token（長效或長期發行的 token）
LINE_CHANNEL_ACCESS_TOKEN=

# Messaging API 頻道的 Channel Secret
LINE_CHANNEL_SECRET=

# ==== 必填：請至 Anthropic Console (https://console.anthropic.com) 取得 ====
ANTHROPIC_API_KEY=

# ==== 選填 ====
# 使用的 Claude 模型，預設為 claude-haiku-4-5（成本較低，適合客服 FAQ 這類任務）
# 想換更高品質的回覆可改成 claude-opus-5（費用約為 Haiku 的 5 倍）
CLAUDE_MODEL=claude-haiku-4-5

# 伺服器監聽的埠號，預設 3000
PORT=3000

# ==== 僅在使用 relay-server.js（跟既有 EasyStore LINE 整合共存測試）時才需要 ====
# EasyStore 現有的 LINE webhook 網址；relay-server.js 會把原始 webhook 內容原封不動轉發過去，
# 讓 EasyStore 的既有流程不受影響，同時另外用 LINE Push API 送出本機器人的測試回覆。
EASYSTORE_WEBHOOK_URL=
